---
import Base from '../layouts/Base.astro';

const groupes = [
  {
    titre: 'Machine',
    items: ['MacBook Pro M4 Pro, 48 Go', 'Un clavier mécanique et deux écrans'],
  },
  {
    titre: 'Écriture de code',
    items: ['Claude Code au terminal', 'Neovim pour les retouches rapides', 'Git, toujours en ligne de commande'],
  },
  {
    titre: 'Langages du quotidien',
    items: ['Python', 'TypeScript', 'Go', 'Du C++ quand il le faut'],
  },
];
---

<Base
  title="Outils — Philippe Lawson"
  description="Les outils avec lesquels je travaille au quotidien."
>
  <section class="band">
    <div class="shell">
      <h1 class="section-title">Outils</h1>

      <p class="statement__gloss">
        Ce que j’utilise pour travailler. Pas ce qui tourne sur mes serveurs : une
        liste d’infrastructure est une carte, et je préfère ne pas la dessiner.
      </p>

      <ul class="entries" style="margin-top: 3rem;">
        {
          groupes.map((g) => (
            <li class="entry">
              <h2 class="entry__title">{g.titre}</h2>
              <p class="entry__blurb">{g.items.join(', ')}.</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>
