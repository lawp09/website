---
import Base from '../layouts/Base.astro';

const kit = [
  {
    quoi: 'Machine',
    items: ['MacBook Pro M4 Pro, 48 Go', 'Un clavier mécanique, deux écrans'],
  },
  {
    quoi: 'Écriture de code',
    items: ['Claude Code au terminal', 'Neovim pour les retouches rapides', 'Git en ligne de commande'],
  },
  {
    quoi: 'Langages du quotidien',
    items: ['Python', 'TypeScript', 'Go', 'Du C++ quand il le faut'],
  },
  {
    quoi: 'Ce site',
    items: ['Astro, généré une fois', 'Aucun script côté client', 'Polices servies depuis le site'],
  },
];
---

<Base
  title="Outils — Philippe Lawson"
  description="Les outils avec lesquels je travaille au quotidien, et pourquoi je m’arrête là."
  section="outils"
>
  <section class="nappe">
    <div class="cadre">
      <div class="entete-section">
        <div>
          <p class="etiquette">Outils</p>
          <h1 class="titre-section">Ce que j’ai sous la main.</h1>
        </div>
        <p class="entete-section__dit">
          Pas ce qui tourne sur mes serveurs : un inventaire d’infrastructure est une
          carte, et je préfère ne pas la dessiner.
        </p>
      </div>

      <ul class="kit">
        {
          kit.map((g) => (
            <li class="kit__group">
              <h2 class="kit__what">{g.quoi}</h2>
              <ul class="kit__items">
                {g.items.map((i) => (
                  <li>{i}</li>
                ))}
              </ul>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>
