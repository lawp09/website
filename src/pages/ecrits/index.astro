---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const isDev = import.meta.env.DEV;

const entries = (await getCollection('ecrits', ({ data }) => isDev || !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const fmt = (d: Date) =>
  d.toLocaleDateString('fr-CA', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
---

<Base
  title="Écrits — Philippe Lawson"
  description="Textes sur la conception de systèmes, la sécurité par défaut et le travail avec des agents."
>
  <section class="band">
    <div class="shell">
      <h1 class="section-title">Écrits</h1>

      <ul class="entries">
        {
          entries.map((e) => (
            <li class="entry">
              <h2 class="entry__title">
                <a href={`/ecrits/${e.id}/`}>{e.data.title}</a>
                {e.data.draft && <span class="entry__draft">brouillon</span>}
              </h2>
              <p class="entry__blurb">{e.data.description}</p>
              <span class="entry__date">
                <time datetime={e.data.date.toISOString()}>{fmt(e.data.date)}</time>
              </span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>
