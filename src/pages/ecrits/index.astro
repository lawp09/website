---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const isDev = import.meta.env.DEV;

const entries = (await getCollection('ecrits', ({ data }) => isDev || !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const fmt = (d: Date) =>
  d.toLocaleDateString('fr-CA', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
---

<Base
  title="Écrits — Philippe Lawson"
  description="Textes sur la conception de systèmes, la sécurité par défaut et le travail avec des agents."
  section="ecrits"
>
  <section class="band">
    <div class="shell">
      <h1 class="lede">Ce que j’écris, je l’ai cassé d’abord.</h1>

      {
        entries.length === 0 ? (
          <p class="pieces__none">Le premier texte arrive.</p>
        ) : (
          <ul class="pieces">
            {entries.map((e) => (
              <li class="piece">
                <a class="piece__link" href={`/ecrits/${e.id}/`}>
                  <h2 class="piece__title">
                    {e.data.title}
                    {e.data.draft && <span class="piece__flag">brouillon</span>}
                  </h2>
                  <p class="piece__blurb">{e.data.description}</p>
                  <span class="piece__when">
                    <time datetime={e.data.date.toISOString()}>{fmt(e.data.date)}</time>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </section>
</Base>
