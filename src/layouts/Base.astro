---
import '../styles/global.css';
import Lisiere from '../components/Lisiere.astro';

interface Props {
  title: string;
  description: string;
  /** 'article' sur une page d'écrit, 'website' partout ailleurs. */
  ogType?: 'website' | 'article';
  publishedTime?: Date;
  modifiedTime?: Date;
  /** Onglet à marquer comme courant dans la navigation. */
  section?: 'ecrits' | 'outils';
}

const {
  title,
  description,
  ogType = 'website',
  publishedTime,
  modifiedTime,
  section,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.png', Astro.site);
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Philippe Lawson" />
    <meta name="theme-color" content="#f1e7d3" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonical} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Écrits — Philippe Lawson"
      href={new URL('/rss.xml', Astro.site)}
    />

    {/* Les trois polices du premier écran : le texte, le titre, les étiquettes. */}
    <link rel="preload" href="/fonts/literata.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/zilla-slab-bold.woff2" as="font" type="font/woff2" crossorigin />
    <link
      rel="preload"
      href="/fonts/courier-prime-bold.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Philippe Lawson" />
    <meta property="og:locale" content="fr_CA" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Philippe Lawson — rien n’est de confiance par défaut."
    />
    {publishedTime && (
      <meta property="article:published_time" content={publishedTime.toISOString()} />
    )}
    {modifiedTime && (
      <meta property="article:modified_time" content={modifiedTime.toISOString()} />
    )}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
  </head>

  <body>
    <div class="feuille">
      <Lisiere motif="tete" />

      <header class="entete cadre">
        <a class="signature" href="/">
          <span class="monogramme" aria-hidden="true"></span>
          <span class="signature__nom">
            <strong>Philippe Boévi Lawson</strong>
            <span class="signature__origines">Strasbourg · Togo · Montréal</span>
          </span>
        </a>

        <nav class="navigation" aria-label="Principal">
          <a href="/#parcours">Parcours</a>
          <a href="/ecrits/" aria-current={section === 'ecrits' ? 'page' : undefined}>Écrits</a>
          <a href="/outils/" aria-current={section === 'outils' ? 'page' : undefined}>Outils</a>
        </nav>
      </header>

      <main>
        <slot />
      </main>

      <footer class="colophon">
        <div class="colophon__dire cadre">
          <span>Montréal, {year} · franco-togolais, né à Strasbourg</span>
          <span>Écrit à la main, servi en statique. Aucun script, aucun traceur.</span>
          <a href="/rss.xml">Flux RSS</a>
        </div>

        {/* Motif : la bande de pied. Le drapeau du Togo en lisière. */}
        <div class="bande-pied" aria-hidden="true">
          <div class="bande-pied__canton">
            <svg width="16" height="16" viewBox="0 0 24 24" focusable="false">
              <path
                d="M12 2.5l2.6 6.6 7.1.4-5.5 4.5 1.8 6.9L12 17l-6 3.9 1.8-6.9-5.5-4.5 7.1-.4z"
                fill="currentColor"></path>
            </svg>
          </div>
          <div class="bande-pied__bandes"></div>
        </div>
      </footer>
    </div>
  </body>
</html>
