---
import Base from './Base.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'ecrits'>;
}

const { entry } = Astro.props;
const { title, description, date, updated, tags, draft } = entry.data;

const fmt = (d: Date) =>
  d.toLocaleDateString('fr-CA', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
---

<Base
  title={`${title} — Philippe Lawson`}
  description={description}
  ogType="article"
  publishedTime={date}
  modifiedTime={updated}
  section="ecrits"
>
  <article class="nappe">
    <div class="cadre">
      <header class="article__head">
        <h1 class="article__title">{title}</h1>

        <p class="article__meta">
          <time datetime={date.toISOString()}>{fmt(date)}</time>
          {updated && <span>révisé le {fmt(updated)}</span>}
          {draft && <span class="piece__flag">brouillon</span>}
        </p>

        {
          tags.length > 0 && (
            <ul class="article__tags">
              {tags.map((t) => (
                <li>{t}</li>
              ))}
            </ul>
          )
        }
      </header>

      <div class="prose">
        <slot />
      </div>

      <p class="article__foot">
        <a href="/ecrits/">Retour aux écrits</a>
      </p>
    </div>
  </article>
</Base>
